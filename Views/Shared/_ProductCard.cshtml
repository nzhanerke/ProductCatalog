@model Product
@{
    var colorClass = Model.Category switch
    {
        "Смартфон" => "phone",
        "Ноутбук" => "laptop",
        _ => "accessory"
    };
    var symbol = Model.Category switch
    {
        "Смартфон" => "▯",
        "Ноутбук" => "▱",
        _ => "◉"
    };
}
<div class="card product-card h-100 border-0 shadow-sm">
    <div class="product-visual @colorClass" aria-hidden="true"><span>@symbol</span></div>
    <div class="card-body d-flex flex-column p-4">
        <div class="text-uppercase category-label mb-2">@Model.Category</div>
        <h2 class="h5 fw-bold mb-3">@Model.Name</h2>
        <div class="mt-auto">
            <div class="price mb-3">@Model.Price.ToString("N0") ₸</div>
            @if (Model.IsAvailable)
            {
                <span class="stock stock-available">● Сатылымда бар</span>
            }
            else
            {
                <span class="stock stock-unavailable">● Қазір жоқ</span>
            }
        </div>
    </div>
</div>
