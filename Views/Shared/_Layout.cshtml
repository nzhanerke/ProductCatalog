<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ProductCatalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand navbar-light">
            <div class="container justify-content-between">
                <a class="navbar-brand fw-bold" asp-controller="Product" asp-action="Index"><span class="brand-mark">P</span> ProductCatalog</a>
                <a class="nav-link small fw-semibold" asp-controller="Product" asp-action="Index">Каталог</a>
            </div>
        </nav>
    </header>
    <main class="container py-5">@RenderBody()</main>
    <footer class="container pb-4"><hr /><div class="text-muted small">© 2026 ProductCatalog · ASP.NET Core MVC · 2-апта тапсырмасы</div></footer>
</body>
</html>
